# Root convenience template — copy values into the service-specific env files:
#   agent/.env              (ADK + LangGraph deep research)
#   deep_research/.env      (Python one-shot CLI)
#   web/.env.local          (Next.js CopilotKit runtime)

# Shared keys
NEBIUS_API_KEY=
TAVILY_API_KEY=

# Nebius Token Factory
NEBIUS_API_BASE=https://api.tokenfactory.nebius.com/v1
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# LangGraph deep research models
NEBIUS_ORCHESTRATOR_MODEL=nvidia/Nemotron-3.5-Super-VL
NEBIUS_WORKER_MODEL=nvidia/Nemotron-3_5-Lightning

# Web runtime (see web/.env.local.example)
AGENT_BASE_URL=http://localhost:8000
LANGGRAPH_DEPLOYMENT_URL=http://localhost:8123
COPILOTKIT_TELEMETRY_DISABLED=true
