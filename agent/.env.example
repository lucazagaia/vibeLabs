# Copy to agent/.env and fill in keys (agent/.env is gitignored).
NEBIUS_API_KEY=
TAVILY_API_KEY=

# Nebius Token Factory (ADK / LiteLLM)
NEBIUS_API_BASE=https://api.tokenfactory.nebius.com/v1

# Nebius Token Factory (LangGraph deep research)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Full LiteLLM model strings per ADK role.
SUPERVISOR_MODEL=nebius/nvidia/Nemotron-3_5-Lightning
DATA_BUDDY_MODEL=nebius/nvidia/Nemotron-3_5-Lightning
RESEARCH_BUDDY_MODEL=nebius/nvidia/nemotron-3-super-120b-a12b

# Token Factory reasoning_effort per role: none, minimal, low, medium, high, xhigh, max.
SUPERVISOR_REASONING=low
DATA_BUDDY_REASONING=low
RESEARCH_BUDDY_REASONING=medium

# LangGraph deep research dual-model defaults
NEBIUS_ORCHESTRATOR_MODEL=nvidia/Nemotron-3.5-Super-VL
NEBIUS_WORKER_MODEL=nvidia/Nemotron-3_5-Lightning

# Optional legacy alias — overrides orchestrator only if set
# NEBIUS_MODEL=nvidia/Nemotron-3.5-Super-VL
