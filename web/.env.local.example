# Copy to web/.env.local. Server-only: the browser talks to /api/copilotkit, never to the agents directly.

# Data Buddy (Python ADK / AG-UI)
AGENT_BASE_URL=http://localhost:8000

# Research Buddy (TypeScript LangGraph deep research)
LANGGRAPH_DEPLOYMENT_URL=http://localhost:8123

# Optional — LangSmith tracing for the LangGraph agent
# LANGSMITH_API_KEY=

# Opt out of CopilotKit runtime telemetry.
COPILOTKIT_TELEMETRY_DISABLED=true
