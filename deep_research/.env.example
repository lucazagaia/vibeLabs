# Required — never commit real values
NEBIUS_API_KEY=
TAVILY_API_KEY=

# Nebius Token Factory
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Orchestrator (plan, route tools, synthesize final report)
NEBIUS_ORCHESTRATOR_MODEL=nvidia/Nemotron-3.5-Super-VL

# Subagents / workers (lane research + extraction via `task`)
NEBIUS_WORKER_MODEL=nvidia/Nemotron-3_5-Lightning

# Optional legacy alias — overrides orchestrator only if set
# NEBIUS_MODEL=nvidia/Nemotron-3.5-Super-VL
